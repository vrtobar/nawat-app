{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": false,
    // TS 6 no longer auto-includes node_modules/@types — Node globals
    // (process, console) must be requested explicitly.
    "types": ["node"]
  }
  // Spec files are deliberately NOT excluded here: this preset backs
  // `tsc --noEmit`, and excluding them means test files are never
  // typechecked. Keeping them out of the emitted build is the job of the
  // consumer's tsconfig.build.json.
}
