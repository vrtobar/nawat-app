{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  // What `tsc` emits into dist. tsconfig.json is the wider view used by the
  // editor and by `tsc --noEmit`, so it includes specs; consumers of this
  // package must not receive them.
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
