{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    // No umbrella "test" task: with no package implementing it, `turbo run
    // test` resolved its ^build dependencies and reported success having run
    // nothing. Call the specific task instead.
    // ^build is required, not an optimization: api's tests import
    // @nahuat/database, which resolves through its "main" to dist/. Without
    // this the suite passes only when a stale dist happens to be present and
    // fails on a fresh checkout.
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    // Implemented by @nahuat/database against docker-compose.test.yml, which
    // runs as its own compose project on ports that do not collide with the
    // development stack. The suite truncates tables and refuses any database
    // not named nahuat_test.
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
