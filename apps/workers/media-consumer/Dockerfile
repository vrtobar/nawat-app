# =============================================================================
# MEDIA CONSUMER
#
# The official Python image rather than public.ecr.aws/lambda/python, and the
# reason is ffmpeg. Amazon Linux 2023 has no ffmpeg package, so the AWS base
# image would mean fetching an unsigned static binary from a third-party site
# and trusting it in a production image. Debian has a signed, versioned,
# security-updated one. Paying for that with an explicit Runtime Interface
# Client is the better side of the trade: package management for a native
# dependency is the harder problem, and awslambdaric is a documented path.
#
# ⚠️ ARM64. The task definitions and the Lambda are both arm64 (ADR 6), and a
# mismatch surfaces as an opaque exec-format error at invocation rather than at
# build. Build with --platform linux/arm64.
#
# LICENSING, recorded because it is invisible later: Debian builds ffmpeg with
# --enable-gpl, so the binary in this image is GPL. It is invoked as a
# subprocess, which is not linking, so nothing here inherits that license. GPL
# obligations attach on DISTRIBUTION, and this image is never distributed — it
# is pushed to a private registry and invoked by our own Lambda. If that ever
# changes, this needs a real look: the audio pipeline uses only LGPL parts of
# ffmpeg (loudnorm is not a GPL filter, and libmp3lame does not require
# --enable-gpl), so an LGPL-only build is achievable if it is ever needed.
# =============================================================================
FROM python:3.13-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/task

COPY pyproject.toml ./
COPY src/ ./src/
COPY contracts/ ./contracts/

RUN pip install --no-cache-dir .

# The contracts are read at runtime relative to this, not packaged into the
# wheel — they are data generated by another workspace, and keeping them a
# plain directory is what lets the CI diff check see them.
ENV MEDIA_CONTRACTS_DIR=/var/task/contracts

ENTRYPOINT ["/usr/local/bin/python", "-m", "awslambdaric"]
CMD ["media_consumer.handler.handler"]
