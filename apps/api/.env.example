# Copy to .env.local (gitignored). Values match docker-compose.yml for
# infra; Auth0 values come from the dev tenant (Auth0 dashboard).
DATABASE_URL=postgresql://nahuat:nahuat@localhost:5432/nahuat_dev
REDIS_URL=redis://localhost:6379
AUTH0_DOMAIN=your-dev-tenant.auth0.com
AUTH0_AUDIENCE=https://api.staging.nahuat.com
AUTH0_CLIENT_ID=dev-client-id
AUTH0_CLIENT_SECRET=dev-client-secret
AUTH0_MGMT_CLIENT_ID=dev-mgmt-client-id
AUTH0_MGMT_CLIENT_SECRET=dev-mgmt-client-secret

# Optional. Unset, both derive from AUTH0_DOMAIN and the API verifies against
# the Auth0 tenant — which is what staging and production do. Set them to point
# verification at a local mock OIDC issuer instead, so role-gated routes can be
# hand-tested without Auth0.
# AUTH0_ISSUER_URL=http://localhost:8080/
# AUTH0_JWKS_URI=http://localhost:8080/jwks
# ---------------------------------------------------------------------------
# In-house access tokens (docs/adr/0018) — this API signs what it verifies.
#
# JWT_SIGNING_KEYS is a base64 JWK Set of private RSA keys. Generate one with:
#
#   npm run auth:keygen --workspace=api
#
# and paste the single line it prints. `npm run auth:keygen -- --rotate` adds a
# new key to an existing set. There is no default and there must not be one: a
# signing key that falls back to a shared value is a key every environment
# mints interchangeable tokens with.
JWT_SIGNING_KEYS=run-npm-run-auth:keygen-and-paste-the-output-here
#
# The API's own public URL, per environment — NOT a shared constant. A local
# token then carries iss/aud of localhost and is structurally invalid against
# staging, which is the exact confusion the single Auth0 tenant allowed and
# docs/adr/0018 sets out to end.
JWT_ISSUER=http://localhost:3001
JWT_AUDIENCE=http://localhost:3001
# Optional, defaults to 3600 (one hour).
# ACCESS_TOKEN_TTL_SECONDS=3600

S3_BUCKET=nahuat-dev
CDN_URL=http://localhost:3001/uploads
SQS_ENABLED=false
WEB_URL=http://localhost:3000
NODE_ENV=development
PORT=3001
