# Copy to .env.local (gitignored). Values match docker-compose.yml for
# infra; Auth0 values come from the dev tenant (Auth0 dashboard).
DATABASE_URL=postgresql://nahuat:nahuat@localhost:5432/nahuat_dev
REDIS_URL=redis://localhost:6379
AUTH0_DOMAIN=your-dev-tenant.auth0.com
AUTH0_AUDIENCE=https://api.nahuat.com
AUTH0_CLIENT_ID=dev-client-id
AUTH0_CLIENT_SECRET=dev-client-secret
AUTH0_MGMT_CLIENT_ID=dev-mgmt-client-id
AUTH0_MGMT_CLIENT_SECRET=dev-mgmt-client-secret
INTERNAL_SECRET=dev-internal-secret
S3_BUCKET=nahuat-dev
CDN_URL=http://localhost:3001/uploads
SQS_ENABLED=false
WEB_URL=http://localhost:3000
NODE_ENV=development
PORT=3001
TEST_JWT_SECRET=dev-test-jwt-secret
