{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  // What `nest build` compiles. tsconfig.json is the wider view used by the
  // editor and by `tsc --noEmit`, so it includes specs; they must not reach
  // dist, or the runtime image ships its own test suite.
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}
