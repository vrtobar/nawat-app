# Copy to .env.local (gitignored). Auth0 values from the dev tenant.
# NOTE: v4 SDK variable names — AUTH0_DOMAIN and APP_BASE_URL, not the
# v3-era AUTH0_ISSUER_BASE_URL / AUTH0_BASE_URL in the planning docs.
AUTH0_DOMAIN=your-dev-tenant.auth0.com
AUTH0_CLIENT_ID=dev-client-id
AUTH0_CLIENT_SECRET=dev-client-secret
# Identifier of the API in Auth0. Required: without it Auth0 returns an opaque
# access token instead of a JWT and the API rejects every request before
# signature verification — a failure that reads as broken auth rather than
# missing configuration.
#
# Must match AUTH0_AUDIENCE in apps/api, and this is the STAGING identifier
# because local development runs against the staging tenant (ADR 5). It said
# https://api.nahuat.com until 2026-08-24, which disagreed with apps/api's own
# example and would have requested an audience the local API does not validate.
AUTH0_AUDIENCE=https://api.staging.nahuat.com
# Session cookie encryption key — generate with: openssl rand -hex 32
AUTH0_SECRET=dev-auth0-secret-32-chars-minimum-here
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001
