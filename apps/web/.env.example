# Copy to .env.local (gitignored).
#
# The Google OAuth client for THIS environment — a SEPARATE client per
# environment, not one client listing three redirect URIs. A shared client makes
# the id identical everywhere, so an ID token obtained locally satisfies
# production's audience check, and it puts production's client secret on every
# machine that runs this app locally.
#
# Both halves live here and only here: the web tier performs the code exchange,
# so it needs the secret; the API only verifies an assertion Google already
# signed, so it holds the id alone. GOOGLE_CLIENT_ID must match the one in
# apps/api for the same environment, or the API rejects every ID token this app
# obtains for failing the audience check.
#
# This client's only authorized redirect URI:
#   http://localhost:3000/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Session cookie encryption — generate with: openssl rand -hex 32
# Auth.js reads this by convention; it replaces AUTH0_SECRET.
AUTH_SECRET=dev-auth-secret-32-chars-minimum-here

APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001
