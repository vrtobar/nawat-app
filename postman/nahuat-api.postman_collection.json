          }
        },
        {
          "name": "Delete translation (ADMIN)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/translations/{{translationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["translations", "{{translationId}}"]
            },
            "description": "Delete. Requires ADMIN."
          }
        }
      ]
    },
