    {
      "name": "Admin read surface (CONTRIBUTOR / ADMIN)",
      "description": "The authenticated reads behind the authoring panel. They exist because every public read hardcodes `isPublished: true`, so no other endpoint can return a draft \u2014 and because content comes back UNRESOLVED here (contentEs and contentEn side by side), which is what lets an edit form round-trip it.\n\nUnscoped: any CONTRIBUTOR+ sees every entry, because any of them may edit every entry. `?mine=true` narrows to your own authorship by choice.",
      "item": [
        {
          "name": "List entries \u2192 saves {{entryId}}",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/entries?status=draft&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "entries"],
              "query": [
                {
                  "key": "status",
                  "value": "draft",
                  "description": "draft (default) | pending-translations | published | all"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "mine",
                  "value": "true",
                  "disabled": true,
                  "description": "Only entries you created, or carrying a translation you created"
                },
                {
                  "key": "q",
                  "value": "takat",
                  "disabled": true,
                  "description": "Case-insensitive substring on nawatContent, not the trigram search"
                }
              ]
            },
            "description": "`status=pending-translations` is the odd one: it reaches through the relation for PUBLISHED entries holding at least one translation that is not, which is where a dialect added after publishing lands. Those are excluded from the public reads in every locale, so the dialect exists only in the panel until someone publishes the entry again."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves the first row's id so the requests below have something to act on.",
                  "let body;",
                  "try { body = pm.response.json(); } catch (e) { body = null; }",
                  "",
                  "pm.test('200 with a data array', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body && body.data, 'no data array').to.be.an('array');",
                  "});",
                  "",
                  "const first = body && body.data && body.data[0];",
                  "if (first) {",
                  "    pm.environment.set('entryId', first.id);",
                  "    console.log('entryId =', first.id, '(' + first.nawatContent + ')');",
                  "} else {",
                  "    console.log('No rows for this status \u2014 nothing saved.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Entry detail \u2192 saves {{entryUpdatedAt}} + {{translationId}}",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/entries/{{entryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "entries", "{{entryId}}"]
            },
            "description": "Unresolved content, both languages, under the same field names the write DTOs use \u2014 so a form PATCHes back exactly what it received.\n\n**Run this before either PATCH.** It saves the `updatedAt` values those requests need as their optimistic lock."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The two PATCH requests need the updatedAt they are editing against.",
                  "// Saved here so the collection can be run top to bottom.",
                  "let body;",
                  "try { body = pm.response.json(); } catch (e) { body = null; }",
                  "",
                  "pm.test('200 with an entry', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(body && body.data && body.data.id, 'no entry').to.be.a('string');",
                  "});",
                  "",
                  "const entry = body && body.data;",
                  "if (entry) {",
                  "    pm.environment.set('entryUpdatedAt', entry.updatedAt);",
                  "    const t = (entry.translations || [])[0];",
                  "    if (t) {",
                  "        pm.environment.set('translationId', t.id);",
                  "        pm.environment.set('translationUpdatedAt', t.updatedAt);",
                  "    } else {",
                  "        console.log('Entry has no translations \u2014 translation requests will 404.');",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
