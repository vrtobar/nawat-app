    {
      "name": "Dictionary \u2014 writes (CONTRIBUTOR / ADMIN)",
      "item": [
        {
          "name": "Create entry (CONTRIBUTOR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nawatContent\": \"kunet\",\n  \"type\": \"WORD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/entries",
              "host": ["{{baseUrl}}"],
              "path": ["entries"]
            },
            "description": "Create a headword only (translations added separately). imageUrl optional. Requires CONTRIBUTOR."
          }
        },
        {
          "name": "Create full entry (CONTRIBUTOR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nawatContent\": \"kunet\",\n  \"type\": \"WORD\",\n  \"translations\": [\n    {\n      \"dialectCode\": \"common\",\n      \"contentEs\": \"ni\u00f1o | beb\u00e9\",\n      \"contentEn\": \"child | baby\",\n      \"partOfSpeech\": \"NOUN\",\n      \"phonetic\": \"[\u02c8kunet]\",\n      \"exampleNawat\": \"Ne kunet kochi.\",\n      \"exampleEs\": \"El ni\u00f1o duerme.\",\n      \"exampleEn\": \"The child sleeps.\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/entries/full",
              "host": ["{{baseUrl}}"],
              "path": ["entries", "full"]
            },
            "description": "Atomic: entry + at least one translation (one per dialect). Requires CONTRIBUTOR."
          }
        },
        {
          "name": "Update entry (CONTRIBUTOR)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expectedUpdatedAt\": \"{{entryUpdatedAt}}\",\n  \"nawatContent\": \"kunet\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/entries/{{entryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["entries", "{{entryId}}"]
            },
            "description": "Partial update. Renaming regenerates the slug. Contributor edits of published content are gated.\n\n**Requires `expectedUpdatedAt`** \u2014 the `updatedAt` you last read. The update is conditional on it, so a row that changed since you loaded it answers 409 EDIT_CONFLICT rather than overwriting the other edit. Run \"Entry detail\" first; it saves the variable."
          }
        },
        {
          "name": "Publish entry (ADMIN)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/entries/{{entryId}}/publish",
              "host": ["{{baseUrl}}"],
              "path": ["entries", "{{entryId}}", "publish"]
            },
            "description": "Publish. Requires ADMIN."
          }
        },
        {
          "name": "Unpublish entry (ADMIN)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/entries/{{entryId}}/unpublish",
              "host": ["{{baseUrl}}"],
              "path": ["entries", "{{entryId}}", "unpublish"]
            },
            "description": "Returns a published entry to draft, cascading to its published translations \u2014 the mirror of Publish, which cascades to its drafts.\n\nExists because publishing was otherwise one-way: an entry published by mistake could only be resolved by deleting it and creating it again, losing its id, slug and attribution over what is usually a wrong gloss."
          }
        },
        {
          "name": "Delete entry (ADMIN)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/entries/{{entryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["entries", "{{entryId}}"]
            },
            "description": "Delete. Requires ADMIN."
          }
        }
      ]
    },
    {
      "name": "Translations (CONTRIBUTOR / ADMIN)",
      "item": [
        {
          "name": "Add translation (CONTRIBUTOR)",
          "request": {
            "method": "POST",
